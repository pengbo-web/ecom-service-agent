.DS_Store
Thumbs.db

# 虚拟环境
venv/
.venv/
env/

# 会话持久化文件
app/sessions/

# 一键启动运行时日志/PID(非项目产物)
.run/

# 执行过程草稿（SDD 进度 ledger，非项目产物）
.superpowers/

# WebUI
webui/node_modules

# Skill 自进化的运行期产物:候选/归档/搬运暂存区。
# 它们由合成器、上传端点、转正与看门狗在运行时生成,内容随真实流量变化,
# 不是源码——进版本库只会让每次跑一遍就产生一堆无意义 diff。
app/agent/skills/definitions/_candidates/
app/agent/skills/definitions/_archive/
app/agent/skills/definitions/_swap/
# 转正/驳回后的候选归档(与上面三个同类:运行期产物,内容随真实流量变化)。
# 它们是"这个候选当时长什么样"的本地证据,不是源码——留在版本库里只会让
# 每次点一次转正就多出一堆 diff。
app/agent/skills/definitions/_promoted/
app/agent/skills/definitions/_rejected/

# 记忆清理脚本的备份目录(含买家原始画像,不入库)
app/sessions/memory_backup_*/
