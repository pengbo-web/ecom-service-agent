# OpenAI API Key
OPENAI_API_KEY=sk-xxx

# API 代理地址（可选，默认为 OpenAI 官方地址）
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型配置
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.7

# 模型容错（Phase 1：主备 fallback + 熔断 + 错误分类重试）
RESILIENCE_ENABLED=true
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
BREAKER_THRESHOLD=3
BREAKER_COOLDOWN_S=60
# 备用模型（留空=无备用，仅对主模型做重试）；配上则主模型故障/欠费时自动切换
FALLBACK_BASE_URL=
FALLBACK_MODEL=
FALLBACK_API_KEY=

# MCP 配置（第4期）
MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:9123/mcp

# Multi-Agent 配置（第6期）
MULTI_AGENT_ENABLED=false

# 提速 + 真人化:关出话流水线(评估/重写/润色,省每轮 2-3 次 LLM)、降 ReAct 步数
REPLY_PIPELINE_ENABLED=false
MAX_REACT_STEPS=3

# Memory 配置（第7期）
MEMORY_ENABLED=true
MEMORY_DIR=app/sessions/memory
MEMORY_USER_ID=default
MAX_LTM_FACTS=50

# Skill 配置（第8期）
SKILLS_ENABLED=true
SKILLS_DIR=app/agent/skills/definitions

# Evaluation 配置（第9期，离线评估工具）
EVAL_DATASET_PATH=app/evaluation/cases.json
EVAL_USE_JUDGE=true
EVAL_PASS_THRESHOLD=0.6

# RAG 配置（第5期）
EMBEDDING_MODEL=text-embedding-3-small
KB_DIR=app/agent/rag/knowledge
# 向量后端：numpy（手写余弦，教学透明）/ chroma（向量数据库，生产代表）
RAG_BACKEND=numpy
# NumpyBackend 索引文件
KB_INDEX_PATH=app/sessions/kb_index.json
# ChromaBackend 持久化目录 + collection
CHROMA_PERSIST_DIR=app/sessions/chroma
CHROMA_COLLECTION=ecom_kb

# Langfuse 观测平台(可选体验,自托管 http://localhost:3000)
# LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_HOST=http://localhost:3000

# 极简登录态(两档用户体系:先创建才可用 + 身份从签名 token 解出)
AUTH_ENABLED=true
# 生产必须换成随机长密钥,勿沿用默认值!
AUTH_SECRET=dev-secret-change-in-prod
AUTH_TOKEN_TTL=86400
