# OpenAI API Key
OPENAI_API_KEY=sk-xxx

# API 代理地址（可选，默认为 OpenAI 官方地址）
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型配置
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.7

# 模型容错（Phase 1：主备 fallback + 熔断 + 错误分类重试）
RESILIENCE_ENABLED=true
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
BREAKER_THRESHOLD=3
BREAKER_COOLDOWN_S=60
# 备用模型（留空=无备用，仅对主模型做重试）；配上则主模型故障/欠费时自动切换
FALLBACK_BASE_URL=
FALLBACK_MODEL=
FALLBACK_API_KEY=

# MCP 配置（第4期）
MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:9123/mcp

# Multi-Agent 配置（第6期）
MULTI_AGENT_ENABLED=false

# 自进化 Skill 闭环:记录 skill 执行轨迹(供失败采集/门禁);候选灰度评测容差
SKILL_TRACE_ENABLED=true
SKILL_GATE_TOLERANCE=0.05
SKILL_CANARY_ENABLED=true
SKILL_PRELOAD_ENABLED=true

# 提速 + 真人化:关出话流水线(评估/重写/润色,省每轮 2-3 次 LLM)、降 ReAct 步数
REPLY_PIPELINE_ENABLED=false
MAX_REACT_STEPS=3

# Memory 配置（第7期）
MEMORY_ENABLED=true
MEMORY_DIR=app/sessions/memory
MEMORY_USER_ID=default
MAX_LTM_FACTS=50

# Skill 配置（第8期）
SKILLS_ENABLED=true
SKILLS_DIR=app/agent/skills/definitions

# Evaluation 配置（第9期，离线评估工具）
EVAL_DATASET_PATH=app/evaluation/cases.json
EVAL_USE_JUDGE=true
EVAL_PASS_THRESHOLD=0.6

# RAG 配置（第5期）
EMBEDDING_MODEL=text-embedding-3-small
KB_DIR=app/agent/rag/knowledge
# 向量后端：numpy（手写余弦，教学透明）/ chroma（向量数据库，生产代表）
RAG_BACKEND=numpy
# NumpyBackend 索引文件
KB_INDEX_PATH=app/sessions/kb_index.json
# ChromaBackend 持久化目录 + collection
CHROMA_PERSIST_DIR=app/sessions/chroma
CHROMA_COLLECTION=ecom_kb

# Langfuse 观测平台(可选体验,自托管 http://localhost:3000)
# LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_HOST=http://localhost:3000

# 极简登录态(两档用户体系:先创建才可用 + 身份从签名 token 解出)
AUTH_ENABLED=true
# 生产必须换成随机长密钥,勿沿用默认值!
AUTH_SECRET=dev-secret-change-in-prod
AUTH_TOKEN_TTL=86400

# ---- 协作队列载体(PG2:队列切片)----
# 默认 sqlite。**这不是保守,是因为只迁队列有代价**:业务数据仍在 SQLite,
# 开了 pg 之后 publish 与业务写就不在同一事务里了。长期方向是 PG3 把业务库
# 整体迁过来(见 docs/superpowers/plans/2026-08-08-postgres-migration.md 第一节:
# 只迁队列是本末倒置)。这个开关现阶段的用途是**验证 PG 路子与多实例认领**。
#
# SQLite 版 claim 是"先 SELECT 候选 id、再逐行条件 UPDATE":单实例正确,多实例下
# 两个 worker 会 SELECT 到同一批 id 再互相抢,抢输的白跑一圈——**不报错**,只表现为
# "worker 在跑但吞吐上不去"。PG 用 FOR UPDATE SKIP LOCKED 让并发 worker 各取各的。
#
# 起一个可连的 PG(端口用 5442,因为 5432 常被 aperag-postgres 占着):
#   docker run -d --name ecom-pg --restart unless-stopped -p 5442:5432 \
#     -e POSTGRES_PASSWORD=ecom_dev_pw -e POSTGRES_USER=ecom -e POSTGRES_DB=ecom \
#     postgres:15-alpine
# COLLAB_BUS_BACKEND=pg
# COLLAB_PG_DSN=postgresql://ecom:ecom_dev_pw@127.0.0.1:5442/ecom

# ---- Generator != Evaluator(见 app/evaluation/independence.py)----
# 裁判模型必须与被评 Agent / skill 编辑器不同族,否则 judge 打的
# answer_quality / faithfulness / process_soundness 是自评,而门禁的
# avg_result_score / avg_process_score 主要由它们构成。
# deepseek-v3 与 qwen-plus 在同一个 DashScope 端点上,已实测可调,无需额外端点。
EVAL_JUDGE_MODEL=deepseek-v3
